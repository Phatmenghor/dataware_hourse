# Backend Development Environment
# Local development with debug settings and test databases

SPRING_PROFILES_ACTIVE=local

# Primary Database (PostgreSQL) - Local Development
DB_URL=jdbc:postgresql://localhost:5432/dwh_bi_local
DB_USER=postgres
DB_PASSWORD=password
DB_DRIVER=org.postgresql.Driver

# Oracle Database - Local Development (Optional)
DB_ORACLE_URL=jdbc:oracle:thin:@localhost:1521:XE
DB_ORACLE_USER=
DB_ORACLE_PASSWORD=
DB_ORACLE_DRIVER=oracle.jdbc.OracleDriver

# JWT Configuration - Development
JWT_SECRET=dev-secret-key-change-in-production-12345
JWT_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# Server Configuration
SERVER_PORT=8081
SERVER_SERVLET_CONTEXT_PATH=/api

# Logging - Verbose for Development
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_DWH=DEBUG

# Excel Export
EXCEL_EXPORT_ENABLED=true
EXCEL_EXPORT_TEMP_DIR=./temp/excel
EXCEL_EXPORT_MAX_ROWS=10000

# Security - Relaxed for Development
SECURITY_JWT_REQUIRE_HTTPS=false
SECURITY_JWT_COOKIE_SECURE=false
SECURITY_JWT_COOKIE_HTTP_ONLY=true

# Mail Configuration (Optional)
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=dev-user
MAIL_PASSWORD=dev-password
MAIL_FROM=dev@dwh-bi.local
