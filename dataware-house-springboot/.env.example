# Backend Environment Configuration Template
# Copy this file to .env.local for development or use for CI/CD pipelines

# ============================================
# Spring Boot Configuration
# ============================================
SPRING_PROFILES_ACTIVE=local

# ============================================
# Primary Database (PostgreSQL)
# ============================================
DB_URL=jdbc:postgresql://localhost:5432/dwh_bi
DB_USER=postgres
DB_PASSWORD=password
DB_DRIVER=org.postgresql.Driver

# ============================================
# Oracle Database (Optional - for reporting)
# ============================================
DB_ORACLE_URL=jdbc:oracle:thin:@localhost:1521:ORCL
DB_ORACLE_USER=oracle_user
DB_ORACLE_PASSWORD=oracle_password
DB_ORACLE_DRIVER=oracle.jdbc.OracleDriver

# ============================================
# JWT Configuration
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# ============================================
# Server Configuration
# ============================================
SERVER_PORT=8081
SERVER_SERVLET_CONTEXT_PATH=/api

# ============================================
# Logging
# ============================================
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_DWH=DEBUG

# ============================================
# Excel Export
# ============================================
EXCEL_EXPORT_ENABLED=true
EXCEL_EXPORT_TEMP_DIR=./temp/excel
EXCEL_EXPORT_MAX_ROWS=10000

# ============================================
# Security
# ============================================
SECURITY_JWT_REQUIRE_HTTPS=false
SECURITY_JWT_COOKIE_SECURE=false
SECURITY_JWT_COOKIE_HTTP_ONLY=true

# ============================================
# Mail Configuration (Optional)
# ============================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=noreply@dwh-bi.com
