# Backend Production Environment
# Production settings with security hardening and optimized configuration
# IMPORTANT: Use secure secret management (AWS Secrets Manager, HashiCorp Vault, etc.)
# Do NOT commit actual secrets to version control

SPRING_PROFILES_ACTIVE=prod

# Primary Database (PostgreSQL) - Production
DB_URL=jdbc:postgresql://prod-db-server:5432/dwh_bi
DB_USER=${DB_USER}
DB_PASSWORD=${DB_PASSWORD}
DB_DRIVER=org.postgresql.Driver

# Oracle Database - Production (Optional - for reporting)
DB_ORACLE_URL=${DB_ORACLE_URL}
DB_ORACLE_USER=${DB_ORACLE_USER}
DB_ORACLE_PASSWORD=${DB_ORACLE_PASSWORD}
DB_ORACLE_DRIVER=oracle.jdbc.OracleDriver

# JWT Configuration - Production
# Generate strong secret: openssl rand -base64 32
JWT_SECRET=${JWT_SECRET}
JWT_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# Server Configuration
SERVER_PORT=8080
SERVER_SERVLET_CONTEXT_PATH=/api

# Logging - Minimal for Production
LOGGING_LEVEL_ROOT=WARN
LOGGING_LEVEL_DWH=WARN

# Excel Export
EXCEL_EXPORT_ENABLED=true
EXCEL_EXPORT_TEMP_DIR=/var/tmp/dwh_bi/excel
EXCEL_EXPORT_MAX_ROWS=100000

# Security - Hardened for Production
SECURITY_JWT_REQUIRE_HTTPS=true
SECURITY_JWT_COOKIE_SECURE=true
SECURITY_JWT_COOKIE_HTTP_ONLY=true

# Mail Configuration - Production
MAIL_HOST=${MAIL_HOST}
MAIL_PORT=587
MAIL_USERNAME=${MAIL_USERNAME}
MAIL_PASSWORD=${MAIL_PASSWORD}
MAIL_FROM=noreply@dwh-bi.com

# Additional Production Settings
# Database Connection Pool
DB_MAX_POOL_SIZE=20
DB_MIN_IDLE=5
DB_CONNECTION_TIMEOUT=30000
DB_IDLE_TIMEOUT=600000
DB_MAX_LIFETIME=1800000

# Performance Tuning
HIBERNATE_BATCH_SIZE=20
HIBERNATE_FETCH_SIZE=50

# Monitoring
ACTUATOR_ENABLED=true
ACTUATOR_ENDPOINTS=/actuator/health,/actuator/metrics
